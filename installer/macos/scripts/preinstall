#!/bin/bash
# OpenAVC .pkg preinstall — runs as root before files are laid down.
#
# On an upgrade the daemon is running and holds the old binary + the HTTP
# port. Stop it first so the installer can replace /Applications/OpenAVC.app
# cleanly (the macOS analog of the Inno Setup PrepareToInstall service stop).
# Tolerate a fresh install where nothing is loaded yet.
#
# What an install leaves to roll back to is what an in-app update leaves
# (installer/apply-lib.sh); tests/test_installer_conformance.py holds the two
# the same.

APP="${OPENAVC_APP:-/Applications/OpenAVC.app}"
# The launchctl that stops the services. Only the installed app's own run uses
# the system's; a sandbox run (OPENAVC_APP pointed elsewhere, as the tests do)
# stops nothing unless it names its own, so running the tests never stops the
# server or the menu bar of the Mac they run on. openavc-macos-run.sh has the
# same rule.
if [ "$APP" = "/Applications/OpenAVC.app" ]; then
    LAUNCHCTL="${OPENAVC_LAUNCHCTL:-/bin/launchctl}"
else
    LAUNCHCTL="${OPENAVC_LAUNCHCTL:-}"
fi

console_uid() {
    if [ -n "${OPENAVC_CONSOLE_UID+x}" ]; then
        echo "$OPENAVC_CONSOLE_UID"
    else
        stat -f %u /dev/console 2>/dev/null
    fi
}

if [ -n "$LAUNCHCTL" ]; then
    "$LAUNCHCTL" bootout system/com.openavc.server 2>/dev/null || true

    # Stop the menu-bar agent in the logged-in user's session too, so its binary
    # isn't locked while the bundle is replaced.
    CONSOLE_UID="$(console_uid)"
    if [ -n "${CONSOLE_UID:-}" ] && [ "$CONSOLE_UID" != "0" ]; then
        "$LAUNCHCTL" bootout "gui/$CONSOLE_UID/com.openavc.menubar" 2>/dev/null || true
    fi

    # Give launchd a moment to release the listening socket and file handles.
    sleep 1
fi

# The copy kept to roll back to is the app this install replaces, whole, as an
# in-app update keeps it. An older copy goes whether or not an app is here to
# take its place: left beside this release, it is what Rollback on the Updates
# page would offer. The app is copied, where an update moves it aside, so
# Installer still lays this release over it as it always has. A copy that
# cannot be made is removed, and the install goes on with nothing to roll
# back to rather than part of an app.
PREVIOUS="$APP.previous"
rm -rf "$PREVIOUS"
if [ -e "$PREVIOUS" ] || [ -L "$PREVIOUS" ]; then
    echo "preinstall: could not remove $PREVIOUS, an older copy Rollback may still offer"
elif [ -d "$APP" ] && ! cp -a "$APP" "$PREVIOUS"; then
    echo "preinstall: could not copy $APP to $PREVIOUS; this install leaves nothing to roll back to"
    rm -rf "$PREVIOUS"
fi

# 0.24.1 and earlier put the bundled data at _internal/server, _internal/simulator,
# _internal/web and _internal/themes; 0.25.0 puts all of it under _internal/openavc.
# Installer upgrades a bundle by merging, so the old set would survive alongside
# the new one -- and _internal is on the frozen app's sys.path, so a driver's
# _sim.py that still says `from simulator.…` would import the stale 0.24.1 copy
# instead of failing with the message that says to update the driver.
INTERNAL="$APP/Contents/Resources/server/_internal"
for stale in server simulator web themes; do
    rm -rf "${INTERNAL:?}/$stale"
done

exit 0
