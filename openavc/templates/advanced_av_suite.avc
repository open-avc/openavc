{
    "openavc_version": "0.12.0",
    "project": {
        "id": "advanced_av_suite",
        "name": "Advanced AV Suite",
        "description": "Multi-device setup with scripted automation: occupancy-based auto-shutdown, volume mapping, source routing logic, status polling, and custom event handling.",
        "created": "2026-04-06T00:00:00",
        "modified": "2026-04-06T00:00:00"
    },
    "devices": [
        {
            "id": "display1",
            "driver": "pjlink_class1",
            "name": "Main Display",
            "config": {},
            "child_entities": {}
        },
        {
            "id": "display2",
            "driver": "pjlink_class1",
            "name": "Confidence Monitor",
            "config": {},
            "child_entities": {}
        },
        {
            "id": "switcher1",
            "driver": "generic_tcp",
            "name": "Matrix Switcher",
            "config": {},
            "child_entities": {}
        },
        {
            "id": "dsp1",
            "driver": "generic_tcp",
            "name": "DSP",
            "config": {},
            "child_entities": {}
        },
        {
            "id": "camera1",
            "driver": "generic_tcp",
            "name": "PTZ Camera",
            "config": {},
            "child_entities": {}
        },
        {
            "id": "sensor1",
            "driver": "generic_tcp",
            "name": "Occupancy Sensor",
            "config": {
                "transport": "http"
            },
            "child_entities": {}
        }
    ],
    "variables": [
        {
            "id": "system_power",
            "type": "string",
            "default": "off",
            "label": "System Power"
        },
        {
            "id": "current_source",
            "type": "string",
            "default": "none",
            "label": "Active Source"
        },
        {
            "id": "volume",
            "type": "integer",
            "default": 40,
            "label": "Volume"
        },
        {
            "id": "mic_mute",
            "type": "boolean",
            "default": true,
            "label": "Mic Mute"
        },
        {
            "id": "display_status",
            "type": "string",
            "default": "Off",
            "label": "Display Status"
        },
        {
            "id": "room_occupied",
            "type": "boolean",
            "default": false,
            "label": "Room Occupied"
        },
        {
            "id": "auto_shutdown_warning",
            "type": "boolean",
            "default": false,
            "label": "Shutdown Warning Active"
        },
        {
            "id": "mode",
            "type": "string",
            "default": "standard",
            "label": "Presentation Mode"
        }
    ],
    "macros": [
        {
            "id": "system_on",
            "name": "System On",
            "steps": [
                {
                    "action": "device.command",
                    "device": "display1",
                    "command": "power_on"
                },
                {
                    "action": "device.command",
                    "device": "display2",
                    "command": "power_on"
                },
                {
                    "action": "delay",
                    "seconds": 2
                },
                {
                    "action": "state.set",
                    "key": "var.system_power",
                    "value": "on"
                },
                {
                    "action": "state.set",
                    "key": "var.current_source",
                    "value": "laptop"
                },
                {
                    "action": "event.emit",
                    "event": "custom.system_ready"
                }
            ]
        },
        {
            "id": "system_off",
            "name": "System Off",
            "steps": [
                {
                    "action": "state.set",
                    "key": "var.system_power",
                    "value": "off"
                },
                {
                    "action": "state.set",
                    "key": "var.current_source",
                    "value": "none"
                },
                {
                    "action": "state.set",
                    "key": "var.auto_shutdown_warning",
                    "value": false
                },
                {
                    "action": "device.command",
                    "device": "dsp1",
                    "command": "mute",
                    "params": {
                        "channel": "program",
                        "muted": true
                    }
                },
                {
                    "action": "device.command",
                    "device": "display1",
                    "command": "power_off"
                },
                {
                    "action": "device.command",
                    "device": "display2",
                    "command": "power_off"
                }
            ]
        }
    ],
    "ui": {
        "settings": {
            "theme": "dark",
            "accent_color": "#00BCD4"
        },
        "pages": [
            {
                "id": "main",
                "name": "Main",
                "elements": [
                    {
                        "id": "lbl_title",
                        "type": "label",
                        "text": "AV Suite",
                        "style": {
                            "font_size": 1.4286
                        },
                        "parent": null
                    },
                    {
                        "id": "lbl_display_status",
                        "type": "label",
                        "text": "",
                        "style": {
                            "font_size": 0.7857,
                            "text_align": "center"
                        },
                        "bindings": {
                            "show": {
                                "value": {
                                    "key": "var.display_status",
                                    "format": "{value}"
                                }
                            }
                        },
                        "parent": null
                    },
                    {
                        "id": "btn_on",
                        "type": "button",
                        "label": "System On",
                        "bindings": {
                            "show": {
                                "look": {
                                    "key": "var.system_power",
                                    "condition": {
                                        "equals": "on"
                                    },
                                    "style_active": {
                                        "bg_color": "#4CAF50"
                                    },
                                    "style_inactive": {
                                        "bg_color": "#424242"
                                    }
                                }
                            },
                            "do": {
                                "press": [
                                    {
                                        "action": "macro",
                                        "macro": "system_on"
                                    }
                                ]
                            }
                        },
                        "parent": null
                    },
                    {
                        "id": "btn_off",
                        "type": "button",
                        "label": "System Off",
                        "bindings": {
                            "show": {
                                "look": {
                                    "key": "var.system_power",
                                    "condition": {
                                        "equals": "off"
                                    },
                                    "style_active": {
                                        "bg_color": "#F44336"
                                    },
                                    "style_inactive": {
                                        "bg_color": "#424242"
                                    }
                                }
                            },
                            "do": {
                                "press": [
                                    {
                                        "action": "macro",
                                        "macro": "system_off"
                                    }
                                ]
                            }
                        },
                        "parent": null
                    },
                    {
                        "id": "btn_laptop",
                        "type": "button",
                        "label": "Laptop",
                        "bindings": {
                            "show": {
                                "look": {
                                    "key": "var.current_source",
                                    "condition": {
                                        "equals": "laptop"
                                    },
                                    "style_active": {
                                        "bg_color": "#00BCD4"
                                    },
                                    "style_inactive": {
                                        "bg_color": "#424242"
                                    }
                                }
                            },
                            "do": {
                                "press": [
                                    {
                                        "action": "script.call",
                                        "script": "room_automation",
                                        "function": "select_source",
                                        "params": {
                                            "source": "laptop"
                                        }
                                    }
                                ]
                            }
                        },
                        "parent": null
                    },
                    {
                        "id": "btn_wireless",
                        "type": "button",
                        "label": "Wireless",
                        "bindings": {
                            "show": {
                                "look": {
                                    "key": "var.current_source",
                                    "condition": {
                                        "equals": "wireless"
                                    },
                                    "style_active": {
                                        "bg_color": "#00BCD4"
                                    },
                                    "style_inactive": {
                                        "bg_color": "#424242"
                                    }
                                }
                            },
                            "do": {
                                "press": [
                                    {
                                        "action": "script.call",
                                        "script": "room_automation",
                                        "function": "select_source",
                                        "params": {
                                            "source": "wireless"
                                        }
                                    }
                                ]
                            }
                        },
                        "parent": null
                    },
                    {
                        "id": "btn_bluray",
                        "type": "button",
                        "label": "Blu-ray",
                        "bindings": {
                            "show": {
                                "look": {
                                    "key": "var.current_source",
                                    "condition": {
                                        "equals": "bluray"
                                    },
                                    "style_active": {
                                        "bg_color": "#00BCD4"
                                    },
                                    "style_inactive": {
                                        "bg_color": "#424242"
                                    }
                                }
                            },
                            "do": {
                                "press": [
                                    {
                                        "action": "script.call",
                                        "script": "room_automation",
                                        "function": "select_source",
                                        "params": {
                                            "source": "bluray"
                                        }
                                    }
                                ]
                            }
                        },
                        "parent": null
                    },
                    {
                        "id": "sld_volume",
                        "type": "slider",
                        "label": "Volume",
                        "min": 0,
                        "max": 100,
                        "step": 1,
                        "bindings": {
                            "show": {
                                "value": {
                                    "source": "state",
                                    "key": "var.volume",
                                    "write_back": true
                                }
                            }
                        },
                        "parent": null
                    },
                    {
                        "id": "btn_mic_mute",
                        "type": "button",
                        "label": "Mic Mute",
                        "bindings": {
                            "show": {
                                "look": {
                                    "key": "var.mic_mute",
                                    "condition": {
                                        "equals": true
                                    },
                                    "style_active": {
                                        "bg_color": "#F44336",
                                        "label": "Mic MUTED"
                                    },
                                    "style_inactive": {
                                        "bg_color": "#4CAF50",
                                        "label": "Mic Live"
                                    }
                                }
                            },
                            "do": {
                                "press": [
                                    {
                                        "action": "script.call",
                                        "script": "room_automation",
                                        "function": "toggle_mic_mute",
                                        "params": {}
                                    }
                                ]
                            }
                        },
                        "parent": null
                    },
                    {
                        "id": "led_occupancy",
                        "type": "status_led",
                        "bindings": {
                            "show": {
                                "look": {
                                    "key": "var.room_occupied",
                                    "map": {
                                        "true": "#4CAF50",
                                        "false": "#9E9E9E"
                                    },
                                    "default": "#9E9E9E"
                                }
                            }
                        },
                        "parent": null
                    },
                    {
                        "id": "lbl_occupancy",
                        "type": "label",
                        "text": "",
                        "style": {
                            "font_size": 0.8571
                        },
                        "bindings": {
                            "show": {
                                "value": {
                                    "key": "var.room_occupied",
                                    "condition": {
                                        "equals": true
                                    },
                                    "text_true": "Room Occupied",
                                    "text_false": "Room Empty"
                                }
                            }
                        },
                        "parent": null
                    },
                    {
                        "id": "lbl_shutdown_warn",
                        "type": "label",
                        "text": "",
                        "style": {
                            "font_size": 0.8571,
                            "text_color": "#FF9800"
                        },
                        "bindings": {
                            "show": {
                                "value": {
                                    "key": "var.auto_shutdown_warning",
                                    "condition": {
                                        "equals": true
                                    },
                                    "text_true": "Auto-shutdown in 5 minutes...",
                                    "text_false": ""
                                }
                            }
                        },
                        "parent": null
                    },
                    {
                        "id": "nav_presets",
                        "type": "page_nav",
                        "label": "Camera & Presets",
                        "target_page": "presets",
                        "parent": null
                    },
                    {
                        "id": "sel_mode",
                        "type": "select",
                        "label": "Mode",
                        "options": [
                            {
                                "label": "Standard",
                                "value": "standard"
                            },
                            {
                                "label": "Video Playback",
                                "value": "video"
                            },
                            {
                                "label": "Teleconference",
                                "value": "teleconference"
                            }
                        ],
                        "bindings": {
                            "show": {
                                "value": {
                                    "source": "state",
                                    "key": "var.mode",
                                    "write_back": true
                                }
                            },
                            "do": {
                                "change": [
                                    {
                                        "action": "script.call",
                                        "script": "room_automation",
                                        "function": "apply_mode",
                                        "params": {
                                            "mode": "$value"
                                        }
                                    }
                                ]
                            }
                        },
                        "parent": null
                    }
                ],
