exports[`the Basic section, every element type > fader, set (page) 1`] = `
"div style="display: flex; flex-direction: column; gap: var(--space-sm);"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "ID"
    input title="Rename element (Enter to commit, Esc to cancel)" style="flex: 1 1 0%; background: var(--bg-primary); cursor: text;" value="el"
    div data-stub="CopyButton" data-props="{\\"value\\":\\"el\\",\\"title\\":\\"Copy element ID\\"}"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Type"
    input readonly="" style="flex: 1 1 0%; opacity: 0.6; cursor: default; background: var(--bg-surface);" value="fader"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Tag"
    input placeholder="optional" style="flex: 1 1 0%;" value=""
  div style="font-size: var(--font-size-xs, 11px); color: var(--text-muted); margin: -4px 0px 4px 0px;"
    "A macro this control runs reads it as"
    code
      "$trigger.tag"
    ", so a row of buttons can share one macro instead of needing one each."
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Label"
    input style="flex: 1 1 0%;" value=""
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Min"
    input type="number" placeholder="0" style="flex: 1 1 0%;" value="0"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Max"
    input type="number" placeholder="100" style="flex: 1 1 0%;" value="1"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Step"
    input type="number" placeholder="1" min="0.01" step="0.1" style="flex: 1 1 0%;" value="0.01"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Unit"
    input placeholder="e.g. dB, %" style="flex: 1 1 0%;" value="%"
  div data-stub="MatchDriverRangeRow" data-props="{\\"element\\":{\\"id\\":\\"el\\",\\"type\\":\\"fader\\",\\"min\\":0,\\"max\\":1,\\"step\\":0.01,\\"unit\\":\\"%\\",\\"orientation\\":\\"horizontal\\",\\"style\\":{\\"show_value\\":false,\\"show_scale\\":false},\\"output_min\\":-60,\\"output_max\\":0,\\"scale_to_full\\":true,\\"response\\":\\"logarithmic\\",\\"send_on_release\\":true}}"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Orientation"
    select style="flex: 1 1 0%;" value="horizontal"
      option value="vertical"
        "Vertical"
      option value="horizontal"
        "Horizontal"
  div style="font-size: 10px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin-top: 6px; padding-bottom: 2px; border-bottom: 1px solid var(--border-color);"
    "Display Options"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Show Value"
    label style="display: flex; align-items: center; gap: 6px; font-size: 11px; cursor: pointer;"
      input type="checkbox" checked=false
      "Display current value"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Show Scale"
    label style="display: flex; align-items: center; gap: 6px; font-size: 11px; cursor: pointer;"
      input type="checkbox" checked=false
      "Show scale markings"
  div style="font-size: 10px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin-top: 6px; padding-bottom: 2px; border-bottom: 1px solid var(--border-color);"
    "Output Range"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Output Min"
    input type="number" placeholder="Same as Min" step="any" style="flex: 1 1 0%;" value="-60"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Output Max"
    input type="number" placeholder="Same as Max" step="any" style="flex: 1 1 0%;" value="0"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Scale to Full Range"
    label style="display: flex; align-items: center; gap: 6px; font-size: 11px; cursor: pointer;"
      input type="checkbox" checked=true
      "Hide output limit from end user"
  div style="font-size: 10px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin-top: 6px; padding-bottom: 2px; border-bottom: 1px solid var(--border-color);"
    "Response"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Response"
    select style="flex: 1 1 0%;" value="logarithmic"
      option value="linear"
        "Linear"
      option value="logarithmic"
        "Logarithmic (audio)"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Curve (dB)"
    input type="number" min="6" max="120" step="1" style="flex: 1 1 0%;" value="60"
  div style="font-size: 10px; color: var(--text-muted); margin-top: -2px; margin-bottom: 4px;"
    "Decibels the throw spans. Larger gives finer control near the bottom. Leave at 60 for a typical audio taper."
  div style="font-size: 10px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin-top: 6px; padding-bottom: 2px; border-bottom: 1px solid var(--border-color);"
    "Value & Send"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Shown decimals"
    input type="number" placeholder="Auto" min="0" max="6" step="1" style="flex: 1 1 0%;" value=""
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Send"
    select style="flex: 1 1 0%;" value="release"
      option value="live"
        "While dragging"
      option value="release"
        "On release only"
  div style="font-size: 10px; color: var(--text-muted); margin-top: -2px; margin-bottom: 4px;"
    ""On release only" sends one command when you let go. Use it for devices that can't keep up with a stream of commands. Shown decimals affect the readout, not the value sent (a driver formats that)."
