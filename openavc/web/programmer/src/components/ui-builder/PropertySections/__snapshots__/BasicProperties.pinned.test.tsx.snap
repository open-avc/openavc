#0 input title="Rename element (Enter to commit, Esc to cancel)" value="el" :: focus, change " new_id ", blur -> rename "new_id"
#0 input title="Rename element (Enter to commit, Esc to cancel)" value="el" :: focus, change "abc", key Enter -> rename "abc"
#0 input title="Rename element (Enter to commit, Esc to cancel)" value="el" :: focus, change "abc", key Escape -> rename "abc"
#1 input readonly="" value="clock" :: change "abc" -> nothing
#1 input readonly="" value="clock" :: change "" -> nothing
#1 input readonly="" value="clock" :: change "{\\"a\\":1}" -> nothing
#1 input readonly="" value="clock" :: change "abc", change "" -> nothing
#1 input readonly="" value="clock" :: focus, blur -> nothing
#1 input readonly="" value="clock" :: focus, change " new_id ", blur -> nothing
#1 input readonly="" value="clock" :: focus, change "abc", key Enter -> nothing
#1 input readonly="" value="clock" :: focus, change "abc", key Escape -> nothing
