exports[`the Basic section, every element type > clock, meeting (page) 1`] = `
"div style="display: flex; flex-direction: column; gap: var(--space-sm);"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "ID"
    input title="Rename element (Enter to commit, Esc to cancel)" style="flex: 1 1 0%; background: var(--bg-primary); cursor: text;" value="el"
    div data-stub="CopyButton" data-props="{\\"value\\":\\"el\\",\\"title\\":\\"Copy element ID\\"}"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Type"
    input readonly="" style="flex: 1 1 0%; opacity: 0.6; cursor: default; background: var(--bg-surface);" value="clock"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Tag"
    input placeholder="optional" style="flex: 1 1 0%;" value=""
  div style="font-size: var(--font-size-xs, 11px); color: var(--text-muted); margin: -4px 0px 4px 0px;"
    "A macro this control runs reads it as"
    code
      "$trigger.tag"
    ", so a row of buttons can share one macro instead of needing one each."
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Mode"
    select style="flex: 1 1 0%;" value="meeting"
      option value="time"
        "Time"
      option value="date"
        "Date"
      option value="datetime"
        "Date + Time"
      option value="countdown"
        "Countdown"
      option value="elapsed"
        "Elapsed"
      option value="meeting"
        "Meeting Timer"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Format"
    input placeholder="mm:ss" style="flex: 1 1 0%;" value=""
  div style="font-size: 10px; color: var(--text-muted); line-height: 1.5; padding: 0px 4px; margin-top: -4px;"
    strong
      "Tokens:"
    "h/hh (12hr) · H/HH (24hr) · mm (min) · ss (sec) · A/a (AM/pm) · D/DD (day) · M/MM (month #) · MMM (Jan) · MMMM (January) · YYYY (year) · ddd (Mon) · dddd (Monday)"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Duration"
    input type="number" placeholder="60" min="1" style="flex: 1 1 0%;" value="30"
    span style="font-size: 10px; color: var(--text-muted);"
      "min"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Timezone"
    input placeholder="America/New_York" style="flex: 1 1 0%; font-size: 11px;" value=""
  div style="font-size: 10px; color: var(--text-muted); padding: 0px 0px 0px 76px;"
    "Leave blank for local time. Uses IANA timezone names."
#0 input title="Rename element (Enter to commit, Esc to cancel)" value="el" :: change "abc" -> nothing
#0 input title="Rename element (Enter to commit, Esc to cancel)" value="el" :: change "" -> nothing
#0 input title="Rename element (Enter to commit, Esc to cancel)" value="el" :: change "{\\"a\\":1}" -> nothing
#0 input title="Rename element (Enter to commit, Esc to cancel)" value="el" :: change "abc", change "" -> nothing
