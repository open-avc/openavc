#3 input value="" :: focus, change "abc", key Escape -> patch {label: "abc"}
#4 button type="button" title="Fill the sources, destinations and route keys in from what the driver declares" :: click -> nothing
#5 button data-emit="onApply {\\"matrix_config\\":{\\"sources\\":[{\\"value\\":1}],\\"destinations\\":[{\\"value\\":1}]}}" :: click -> patch {matrix_config: {sources: [{value: 1}], destinations: [{value: 1}]}}
#6 button data-emit="onClose undefined" :: click -> nothing [control replaced]
#7 select value="crosspoint" :: change "crosspoint" -> patch {matrix_style: "crosspoint"}
#7 select value="crosspoint" :: change "list" -> patch {matrix_style: "list"}
#7 select value="crosspoint" :: change "tiles" -> patch {matrix_style: "tiles"}
#8 input type="checkbox" checked=false :: click -> patch {matrix_config: {sources: [{value: 1}], destinations: [{value: 1}], audio_follow_video: true}}
#9 input type="checkbox" checked=false :: click -> patch {matrix_config: {sources: [{value: 1}], destinations: [{value: 1}], show_lock: true}}
