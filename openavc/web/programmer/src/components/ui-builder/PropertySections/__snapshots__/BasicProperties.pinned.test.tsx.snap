exports[`the Basic section, every element type > matrix, mute left on by default with audio follow (page) 1`] = `
"div style="display: flex; flex-direction: column; gap: var(--space-sm);"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "ID"
    input title="Rename element (Enter to commit, Esc to cancel)" style="flex: 1 1 0%; background: var(--bg-primary); cursor: text;" value="el"
    div data-stub="CopyButton" data-props="{\\"value\\":\\"el\\",\\"title\\":\\"Copy element ID\\"}"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Type"
    input readonly="" style="flex: 1 1 0%; opacity: 0.6; cursor: default; background: var(--bg-surface);" value="matrix"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Tag"
    input placeholder="optional" style="flex: 1 1 0%;" value=""
  div style="font-size: var(--font-size-xs, 11px); color: var(--text-muted); margin: -4px 0px 4px 0px;"
    "A macro this control runs reads it as"
    code
      "$trigger.tag"
    ", so a row of buttons can share one macro instead of needing one each."
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Label"
    input style="flex: 1 1 0%;" value=""
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "From device"
    button type="button" title="Fill the sources, destinations and route keys in from what the driver declares" style="flex: 1 1 0%; padding: 4px 8px; border-radius: var(--border-radius); border: 1px dashed var(--accent); background: rgba(138, 180, 147, 0.08); color: var(--accent); font-size: 11px; cursor: pointer;"
      "Set up from a device…"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Style"
    select style="flex: 1 1 0%;" value="crosspoint"
      option value="crosspoint"
        "Crosspoint Grid"
      option value="list"
        "List (Dropdowns)"
      option value="tiles"
        "Tiles (One Card Per Destination)"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Sources"
    input type="number" min="1" max="32" style="flex: 1 1 0%;" value="4"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Destinations"
    input type="number" min="1" max="32" style="flex: 1 1 0%;" value="4"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Route Key"
    input placeholder="device.sw.output_*_source" style="flex: 1 1 0%; font-size: 11px;" value=""
  div style="font-size: 10px; color: var(--text-muted); padding: 0px 0px 0px 76px;"
    "Use * for the destination number (1-based)"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Audio Route Key"
    input placeholder="device.sw.output_*_audio_source" style="flex: 1 1 0%; font-size: 11px;" value=""
  div style="font-size: 10px; color: var(--text-muted); padding: 0px 0px 0px 76px;"
    "Optional. When set, a destination whose audio is on a different source names it on the panel. Leave it empty when the device keeps audio with the video."
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Source Name Key"
    input placeholder="device.sw.input_*_name" style="flex: 1 1 0%; font-size: 11px;" value=""
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Destination Name Key"
    input placeholder="device.sw.output_*_name" style="flex: 1 1 0%; font-size: 11px;" value=""
  div style="font-size: 10px; color: var(--text-muted); padding: 0px 0px 0px 76px;"
    "Live names from state. * = the entry's number"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Audio Follow"
    input type="checkbox" checked=true
    span style="font-size: 11px; color: var(--text-muted);"
      "Route audio with video"
  div style="font-size: 10px; color: var(--color-warning); padding: 0px 0px 0px 76px; font-style: italic;"
    "Add an Audio Route binding in the Bindings tab to send the audio route command."
  div style="font-size: 10px; color: var(--text-muted); padding: 0px 0px 0px 76px; font-style: italic;"
    "Only enable this if your matrix needs a separate audio route command. Many switchers route audio together with video automatically, so leave this off for those."
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Show Lock"
    input type="checkbox" checked=false
    span style="font-size: 11px; color: var(--text-muted);"
      "Lock buttons per destination"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Show Mute"
    input type="checkbox" checked=true
    span style="font-size: 11px; color: var(--text-muted);"
      "Mute buttons per output"
  div style="font-size: 10px; color: var(--color-warning); padding: 0px 0px 0px 76px; font-style: italic;"
    "Add an Audio Mute Route binding in the Bindings tab so the mute button also mutes audio."
  div style="margin-top: 4px;"
    div style="font-size: 11px; color: var(--text-secondary); margin-bottom: 4px;"
      "Source Labels"
