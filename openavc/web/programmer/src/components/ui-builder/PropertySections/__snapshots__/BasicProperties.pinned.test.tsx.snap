exports[`the Basic section, every element type > gauge, one zone (page) 1`] = `
"div style="display: flex; flex-direction: column; gap: var(--space-sm);"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "ID"
    input title="Rename element (Enter to commit, Esc to cancel)" style="flex: 1 1 0%; background: var(--bg-primary); cursor: text;" value="el"
    div data-stub="CopyButton" data-props="{\\"value\\":\\"el\\",\\"title\\":\\"Copy element ID\\"}"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Type"
    input readonly="" style="flex: 1 1 0%; opacity: 0.6; cursor: default; background: var(--bg-surface);" value="gauge"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Tag"
    input placeholder="optional" style="flex: 1 1 0%;" value=""
  div style="font-size: var(--font-size-xs, 11px); color: var(--text-muted); margin: -4px 0px 4px 0px;"
    "A macro this control runs reads it as"
    code
      "$trigger.tag"
    ", so a row of buttons can share one macro instead of needing one each."
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Label"
    input style="flex: 1 1 0%;" value=""
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Min"
    input type="number" placeholder="0" style="flex: 1 1 0%;" value="5"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Max"
    input type="number" placeholder="100" style="flex: 1 1 0%;" value=""
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Unit"
    input placeholder="%, dB, etc." style="flex: 1 1 0%;" value=""
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Shown decimals"
    input type="number" placeholder="1" min="0" max="6" step="1" style="flex: 1 1 0%;" value=""
  div data-stub="MatchDriverRangeRow" data-props="{\\"element\\":{\\"id\\":\\"el\\",\\"type\\":\\"gauge\\",\\"zones\\":[{\\"from\\":0,\\"to\\":10,\\"color\\":\\"#fff\\"}],\\"min\\":5}}"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Arc Angle"
    input type="number" placeholder="240" min="90" max="360" style="flex: 1 1 0%;" value=""
  div style="font-size: 10px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin-top: 6px; padding-bottom: 2px; border-bottom: 1px solid var(--border-color);"
    "Gauge Appearance"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Gauge Color"
    div data-stub="InlineColorPicker" data-props="{\\"size\\":\\"md\\",\\"clearable\\":true,\\"value\\":\\"\\"}"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Background Arc"
    div data-stub="InlineColorPicker" data-props="{\\"size\\":\\"md\\",\\"clearable\\":true,\\"value\\":\\"\\"}"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Arc Width"
    input type="number" min="2" max="20" style="flex: 1 1 0%;" value="8"
    span style="font-size: 10px; color: var(--text-muted);"
      "px"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Show Value"
    label style="display: flex; align-items: center; gap: 6px; font-size: 11px; cursor: pointer;"
      input type="checkbox" checked=true
      "Display numeric value"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Show Ticks"
    label style="display: flex; align-items: center; gap: 6px; font-size: 11px; cursor: pointer;"
      input type="checkbox" checked=true
      "Show tick marks around the arc"
  div style="display: flex; align-items: center; gap: var(--space-sm);"
    label style="width: 72px; flex-shrink: 0; font-size: var(--font-size-sm); color: var(--text-secondary);"
      "Tick Count"
    input type="number" min="2" max="20" style="flex: 1 1 0%;" value="5"
  div
    div style="display: flex; align-items: center; justify-content: space-between; margin-top: 6px; margin-bottom: 4px;"
      label style="font-size: var(--font-size-sm); color: var(--text-secondary);"
        "Color Zones"
      button style="display: flex; align-items: center; gap: 2px; padding: 2px 6px; border-radius: var(--border-radius); font-size: 11px; color: var(--accent);"
        "Add Zone"
    div style="display: flex; flex-direction: column; gap: 4px;"
      div style="display: flex; align-items: center; gap: 4px;"
        div title="Zone color" style="width: 18px; height: 18px; border-radius: 3px; background-color: rgb(255, 255, 255); border: 1px solid var(--border-color); cursor: pointer; flex-shrink: 0;"
        input type="number" title="Zone start" style="width: 48px; padding: 2px 4px; font-size: 11px;" value="0"
        span style="font-size: 10px; color: var(--text-muted);"
          "to"
        input type="number" title="Zone end" style="width: 48px; padding: 2px 4px; font-size: 11px;" value="10"
        input title="Color hex" style="width: 68px; padding: 2px 4px; font-size: 10px; font-family: monospace;" value="#fff"
        button style="display: flex; padding: 2px; color: var(--text-muted);"
