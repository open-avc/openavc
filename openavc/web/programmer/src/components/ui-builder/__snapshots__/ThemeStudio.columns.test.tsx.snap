g: 0px; border: 1px solid var(--border-color); border-radius: 3px; cursor: pointer; flex-shrink: 0;" type="color" value="#f44336"><input placeholder="#F44336 (inherited)" title="Inherits #F44336" style="flex: 1 1 0%; font-size: 11px; font-family: monospace;" type="text" value=""></div></div><div><div style="display: flex; gap: 8px; align-items: center;"><label style="width: 130px; font-size: 11px; color: var(--text-secondary); font-weight: 400;" title="Green zone of level meters, OK states">Success</label><input style="width: 28px; height: 22px; padding: 0px; border: 1px solid var(--border-color); border-radius: 3px; cursor: pointer; flex-shrink: 0;" type="color" value="#4caf50"><input placeholder="#4CAF50 (inherited)" title="Inherits #4CAF50" style="flex: 1 1 0%; font-size: 11px; font-family: monospace;" type="text" value=""></div></div><div><div style="display: flex; gap: 8px; align-items: center;"><label style="width: 130px; font-size: 11px; color: var(--text-secondary); font-weight: 400;" title="Yellow zone of level meters, lock indicators, caution states">Warning</label><label title="not-a-colour: pick or type a color to change" style="position: relative; width: 28px; height: 22px; border: 1px solid var(--border-color); border-radius: 3px; cursor: pointer; flex-shrink: 0; display: block;"><input aria-label="Pick a color" style="position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; padding: 0px; cursor: pointer;" type="color" value="#ff9800"></label><input placeholder="" style="flex: 1 1 0%; font-size: 11px; font-family: monospace;" type="text" value="not-a-colour"></div></div><div><div style="display: flex; gap: 8px; align-items: center;"><label style="width: 130px; font-size: 11px; color: var(--text-secondary); font-weight: 400;" title="Roundness of every element. 0 sharp, 16+ very round">Border Radius (px)</label><input min="0" max="64" style="flex: 1 1 0%; font-size: 11px;" type="number" value="8"></div></div><div><div style="display: flex; gap: 8px; align-items: center;"><label style="width: 130px; font-size: 11px; color: var(--accent); font-weight: 600;" title="Typeface across the entire panel">Font Family</label><select style="flex: 1 1 0%; font-size: 11px;"><option value="Inter, system-ui, sans-serif">Inter</option><option value="system-ui, sans-serif">System UI</option><option value="'Roboto', sans-serif">Roboto</option><option value="'Segoe UI', sans-serif">Segoe UI</option><option value="Georgia, 'Times New Roman', serif">Serif</option><option value="monospace">Monospace</option></select><button type="button" title="Reset to saved: Inter, system-ui, sans-serif" style="display: flex; align-items: center; padding: 2px; background: transparent; cursor: pointer; color: var(--accent); flex-shrink: 0; opacity: 0.7;"><svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg></button></div></div></div></div>"`;

exports[`the editor column > draws the line and the overrides as they always have been 1`] = `"<div style="padding: 6px 12px; font-size: 11px; color: rgb(102, 187, 106); background: var(--bg-surface); border-bottom: 1px solid var(--border-color);">Reverted to saved values</div>"`;

exports[`the editor column > draws the line and the overrides as they always have been 2`] = `"<div style="padding: 8px 12px; background: rgba(255, 167, 38, 0.12); border-bottom: 1px solid rgba(255, 167, 38, 0.4); color: rgb(255, 167, 38); font-size: 11px; display: flex; align-items: center; gap: 8px;"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-triangle-alert" style="flex-shrink: 0;"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg><div style="flex: 1 1 0%;"><strong>2 project overrides</strong> applied on top of this theme: <code style="font-size: 10px;">accent, font_family</code><div style="color: var(--text-muted); margin-top: 2px;">The panel may not match what the editor shows until these are cleared or saved into the theme.</div></div><button style="padding: 4px 10px; background: transparent; border: 1px solid rgb(255, 167, 38); border-radius: 4px; color: rgb(255, 167, 38); cursor: pointer; font-size: 11px; font-weight: 600; flex-shrink: 0;">Clear overrides</button></div>"`;

exports[`the editor column > lays out the bar, the line, the overrides and the sections in this order 1`] = `
[
  "DIV  Save ChangesSave as Copy Discard Export",
