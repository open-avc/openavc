        },
      ],
      "style": {},
      "type": "select",
    },
    {
      "bindings": {
        "value": {
          "key": "gallery.text",
        },
      },
      "id": "g_text",
      "placeholder": "Type here…",
      "style": {},
      "type": "text_input",
    },
    {
      "bindings": {
        "value": {
          "key": "gallery.gauge",
        },
      },
      "id": "g_gauge",
      "label": "CPU",
      "max": 100,
      "min": 0,
      "style": {},
