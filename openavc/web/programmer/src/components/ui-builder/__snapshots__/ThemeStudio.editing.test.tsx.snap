exports[`the preview > draws the gallery page with its demo values 1`] = `
{
  "elements": [
    {
      "bindings": {},
      "id": "g_header",
      "style": {
        "font_size": 2.5714285714285716,
        "font_weight": 700,
        "text_align": "center",
      },
      "text": "Theme Preview Gallery",
      "type": "label",
    },
    {
      "bindings": {},
      "id": "g_button",
      "label": "Button",
      "style": {},
      "type": "button",
    },
    {
      "bindings": {},
      "id": "g_button_active",
      "label": "Active",
      "style": {
        "bg_color": "var(--panel-accent)",
        "text_color": "var(--panel-button-text)",
      },
      "type": "button",
    },
    {
      "bindings": {},
      "id": "g_label_demo",
      "style": {},
      "text": "Demo label text",
      "type": "label",
    },
    {
      "bindings": {
        "color": {
          "default": "#9E9E9E",
          "key": "gallery.led_on",
          "map": {
            "true": "var(--panel-success)",
          },
        },
      },
      "id": "g_led_ok",
      "label": "OK",
      "style": {},
      "type": "status_led",
    },
    {
      "bindings": {
        "color": {
          "default": "#9E9E9E",
          "key": "gallery.led_on",
          "map": {
            "true": "var(--panel-warning)",
          },
        },
      },
      "id": "g_led_warn",
      "label": "Warn",
      "style": {},
