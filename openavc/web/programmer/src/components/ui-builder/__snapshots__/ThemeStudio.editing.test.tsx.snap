exports[`the Theme section > lists every token with its hint 1`] = `
[
  [
    "Page Background",
    "Behind every page",
  ],
  [
    "Text Color",
    "Default text on labels, sliders, gauges, lists, inputs",
  ],
  [
    "Surface",
    "Slider tracks, dropdowns, text inputs, list rows, fader track, keypad display",
  ],
  [
    "Surface Border",
    "Thin border around surfaces above",
  ],
  [
    "Accent",
    "Slider fill, fader handle, focus, active button, page nav text",
  ],
  [
    "Danger",
    "Red zone of level meters, mute indicators, error states",
  ],
  [
    "Success",
    "Green zone of level meters, OK states",
  ],
  [
    "Warning",
    "Yellow zone of level meters, lock indicators, caution states",
  ],
  [
    "",
    "not-a-colour: pick or type a color to change",
  ],
  [
    "Border Radius (px)",
    "Roundness of every element. 0 sharp, 16+ very round",
  ],
  [
    "Font Family",
    "Typeface across the entire panel",
  ],
]
`;

