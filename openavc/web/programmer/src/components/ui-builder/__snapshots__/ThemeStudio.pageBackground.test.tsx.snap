exports[`the page background's markup > is drawn as it always has been (as loaded) 1`] = `"<div style="background: var(--bg-surface); border-radius: 6px; border: 1px solid var(--border-color); margin-bottom: 10px;"><div style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-secondary); padding: 8px 10px; border-bottom: 1px solid var(--border-color); display: flex; align-items: center;">Page Background</div><div style="display: flex; flex-direction: column; gap: 12px; padding: 10px;"><div style="font-size: 9px; color: var(--text-muted); line-height: 1.3; margin-top: 2px;">The background painted behind every page that doesn't set its own. Color, image, and gradient layer in that order.</div><div><div style="display: flex; gap: 8px; align-items: center;"><label style="width: 90px; font-size: 11px; color: var(--text-secondary); flex-shrink: 0;">Color</label><select style="flex: 1 1 0%; font-size: 11px;"><option value="inherit">Theme page background (default)</option><option value="custom">Custom color</option></select></div><div style="display: flex; gap: 8px; align-items: center; margin-top: 4px;"><span style="width: 90px; font-size: 11px; color: var(--text-secondary); flex-shrink: 0;"></span><input style="width: 28px; height: 22px; padding: 0px; border: 1px solid var(--border-color); border-radius: 3px; cursor: pointer; flex-shrink: 0;" type="color" value="#222222"><input style="flex: 1 1 0%; font-size: 11px; font-family: monospace;" type="text" value="#222222"></div></div><div><label style="display: flex; gap: 8px; align-items: center; font-size: 11px; color: var(--text-secondary); cursor: pointer;"><input type="checkbox">Gradient overlay</label></div><div><div style="display: flex; gap: 8px; align-items: center;"><label style="width: 90px; font-size: 11px; color: var(--text-secondary); flex-shrink: 0;">Image</label><input placeholder="assets://bg.jpg or https://…" style="flex: 1 1 0%; font-size: 11px; font-family: monospace;" type="text" value=""></div><div style="font-size: 9px; color: var(--text-muted); line-height: 1.3; margin-top: 2px;">Upload images in the Assets panel, then reference them as assets://name.</div></div></div></div>"`;

exports[`the page background's markup > is drawn as it always has been (under a token, with a gradient and an image) 1`] = `"<div style="background: var(--bg-surface); border-radius: 6px; border: 1px solid var(--border-color); margin-bottom: 10px;"><div style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-secondary); padding: 8px 10px; border-bottom: 1px solid var(--border-color); display: flex; align-items: center;">Page Background</div><div style="display: flex; flex-direction: column; gap: 12px; padding: 10px;"><div style="font-size: 9px; color: var(--text-muted); line-height: 1.3; margin-top: 2px;">The background painted behind every page that doesn't set its own. Color, image, and gradient layer in that order.</div><div><div style="display: flex; gap: 8px; align-items: center;"><label style="width: 90px; font-size: 11px; color: var(--text-secondary); flex-shrink: 0;">Color</label><select style="flex: 1 1 0%; font-size: 11px;"><option value="inherit">Theme page background (default)</option><option value="custom">Custom color</option></select></div></div><div><label style="display: flex; gap: 8px; align-items: center; font-size: 11px; color: var(--text-secondary); cursor: pointer;"><input type="checkbox" checked="">Gradient overlay</label><div style="display: flex; flex-direction: column; gap: 4px; margin-top: 6px;"><div style="display: flex; gap: 8px; align-items: center;"><label style="width: 90px; font-size: 11px; color: var(--text-secondary); flex-shrink: 0;">From</label><input style="width: 28px; height: 22px; padding: 0px; border: 1px solid var(--border-color); border-radius: 3px; cursor: pointer; flex-shrink: 0;" type="color" value="#111111"><input style="flex: 1 1 0%; font-size: 11px; font-family: monospace;" type="text" value="#111111"></div><div style="display: flex; gap: 8px; align-items: center;"><label style="width: 90px; font-size: 11px; color: var(--text-secondary); flex-shrink: 0;">To</label><label title="rgba(0,0,0,0.5): pick or type a color to change" style="position: relative; width: 28px; height: 22px; border: 1px solid var(--border-color); border-radius: 3px; cursor: pointer; flex-shrink: 0; display: block; background: rgba(0, 0, 0, 0.5);"><input aria-label="Pick a color" style="position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; padding: 0px; cursor: pointer;" type="color" value="#000000"></label><input style="flex: 1 1 0%; font-size: 11px; font-family: monospace;" type="text" value="rgba(0,0,0,0.5)"></div><div style="display: flex; gap: 8px; align-items: center;"><label style="width: 90px; font-size: 11px; color: var(--text-secondary); flex-shrink: 0;">Angle (deg)</label><input min="0" max="360" style="flex: 1 1 0%; font-size: 11px;" type="number" value="30"></div></div></div><div><div style="display: flex; gap: 8px; align-items: center;"><label style="width: 90px; font-size: 11px; color: var(--text-secondary); flex-shrink: 0;">Image</label><input placeholder="assets://bg.jpg or https://…" style="flex: 1 1 0%; font-size: 11px; font-family: monospace;" type="text" value="assets://a.png"></div><div style="font-size: 9px; color: var(--text-muted); line-height: 1.3; margin-top: 2px;">Upload images in the Assets panel, then reference them as assets://name.</div><div style="display: flex; flex-direction: column; gap: 4px; margin-top: 6px;"><div style="display: flex; gap: 8px; align-items: center;"><label style="width: 90px; font-size: 11px; color: var(--text-secondary); flex-shrink: 0;">Fit</label><select style="flex: 1 1 0%; font-size: 11px;"><option value="cover">Cover</option><option value="contain">Contain</option><option value="auto">Actual size</option><option value="100% 100%">Stretch</option></select></div><div style="display: flex; gap: 8px; align-items: center;"><label style="width: 90px; font-size: 11px; color: var(--text-secondary); flex-shrink: 0;">Position</label><input placeholder="center" style="flex: 1 1 0%; font-size: 11px; font-family: monospace;" type="text" value="top"></div><div style="display: flex; gap: 8px; align-items: center;"><label style="width: 90px; font-size: 11px; color: var(--text-secondary); flex-shrink: 0;">Opacity</label><input step="0.05" min="0" max="1" style="flex: 1 1 0%; font-size: 11px;" type="number" value="0.5"></div></div></div></div></div>"`;
