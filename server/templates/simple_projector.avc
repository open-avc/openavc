{
    "openavc_version": "0.8.0",
    "project": {
        "id": "simple_projector",
        "name": "Simple Projector",
        "description": "Single projector with power on/off control.",
        "created": "2026-04-06T00:00:00",
        "modified": "2026-04-06T00:00:00"
    },
    "devices": [
        {
            "id": "projector1",
            "driver": "pjlink_class1",
            "name": "Projector",
            "config": {},
            "child_entities": {}
        }
    ],
    "variables": [
        {
            "id": "system_power",
            "type": "string",
            "default": "off",
            "label": "System Power State"
        }
    ],
    "macros": [
        {
            "id": "system_on",
            "name": "System On",
            "steps": [
                {
                    "action": "device.command",
                    "device": "projector1",
                    "command": "power_on"
                },
                {
                    "action": "state.set",
                    "key": "var.system_power",
                    "value": "on"
                }
            ]
        },
        {
            "id": "system_off",
            "name": "System Off",
            "steps": [
                {
                    "action": "device.command",
                    "device": "projector1",
                    "command": "power_off"
                },
                {
                    "action": "state.set",
                    "key": "var.system_power",
                    "value": "off"
                }
            ]
        }
    ],
    "ui": {
        "settings": {
            "theme": "dark",
            "accent_color": "#2196F3"
        },
        "pages": [
            {
                "id": "main",
                "name": "Main",
                "elements": [
                    {
                        "id": "lbl_title",
                        "type": "label",
                        "text": "Projector Control",
                        "style": {
                            "font_size": 1.4286,
                            "text_align": "center"
                        },
                        "parent": null
                    },
                    {
                        "id": "btn_on",
                        "type": "button",
                        "label": "System On",
                        "style": {
                            "bg_color": "#4CAF50"
                        },
                        "bindings": {
                            "show": {
                                "look": {
                                    "key": "var.system_power",
                                    "condition": {
                                        "equals": "on"
                                    },
                                    "style_active": {
                                        "bg_color": "#4CAF50",
                                        "text_color": "#fff"
                                    },
                                    "style_inactive": {
                                        "bg_color": "#424242"
                                    }
                                }
                            },
                            "do": {
                                "press": [
                                    {
                                        "action": "macro",
                                        "macro": "system_on"
                                    }
                                ]
                            }
                        },
                        "parent": null
                    },
                    {
                        "id": "btn_off",
                        "type": "button",
                        "label": "System Off",
                        "style": {
                            "bg_color": "#F44336"
                        },
                        "bindings": {
                            "show": {
                                "look": {
                                    "key": "var.system_power",
                                    "condition": {
                                        "equals": "off"
                                    },
                                    "style_active": {
                                        "bg_color": "#F44336",
                                        "text_color": "#fff"
                                    },
                                    "style_inactive": {
                                        "bg_color": "#424242"
                                    }
                                }
                            },
                            "do": {
                                "press": [
                                    {
                                        "action": "macro",
                                        "macro": "system_off"
                                    }
                                ]
                            }
                        },
                        "parent": null
                    },
                    {
                        "id": "led_power",
                        "type": "status_led",
                        "bindings": {
                            "show": {
                                "look": {
                                    "key": "var.system_power",
                                    "map": {
                                        "on": "#4CAF50",
                                        "off": "#F44336"
                                    },
                                    "default": "#9E9E9E"
                                }
                            }
                        },
                        "parent": null
                    }
                ],
                "snap": {
                    "enabled": true,
                    "x": 8.3333,
                    "y": 12.5
                },
                "layouts": [
                    {
                        "id": "landscape",
                        "orientation": "landscape",
                        "primary": true,
                        "inherits": null,
                        "placements": {
                            "lbl_title": {
                                "x": 0.625,
                                "y": 1.0,
                                "w": 98.75,
                                "h": 32.0
                            },
                            "btn_on": {
                                "x": 0.625,
                                "y": 34.0,
                                "w": 49.0625,
                                "h": 32.0
                            },
                            "btn_off": {
                                "x": 50.3125,
                                "y": 34.0,
                                "w": 49.0625,
                                "h": 32.0
                            },
                            "led_power": {
                                "x": 25.4688,
                                "y": 67.0,
                                "w": 49.0625,
                                "h": 32.0
                            }
                        },
                        "hidden": []
                    }
                ]
            }
        ]
    },
    "scripts": [],
    "isc": {
        "shared_state": [],
        "auth_key": ""
    },
    "connections": {
        "projector1": {
            "host": "192.168.1.100",
            "port": 4352
        }
    },
    "driver_dependencies": [],
    "plugins": {},
    "plugin_dependencies": [],
    "device_groups": []
}