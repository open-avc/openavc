    {"name": "a setting's empty path beside its line", "origin": "setting_write", "block": {"path": "", "send": "LVL {value}"}, "declared": ["raw"], "form": "raw"},
    {"name": "a setting's empty address beside its line", "origin": "setting_write", "block": {"address": "", "send": "LVL {value}"}, "declared": ["raw"], "form": "raw"},
    {"name": "a setting's empty method beside its line", "origin": "setting_write", "block": {"method": "", "send": "LVL {value}"}, "declared": ["raw"], "form": "raw"},
    {"name": "a setting's empty path beside its method", "origin": "setting_write", "block": {"path": "", "method": "patch", "body": "x={value}"}, "declared": ["http"], "form": "http"},
    {"name": "a setting's path beside its line", "origin": "setting_write", "block": {"path": "/v/{value}", "send": "LVL {value}"}, "declared": ["http", "raw"], "form": "http"},
    {"name": "a setting's address beside its line", "origin": "setting_write", "block": {"address": "/x", "send": "LVL {value}"}, "declared": ["osc", "raw"], "form": "osc"},
    {"name": "a setting's path that is a number, beside its line", "origin": "setting_write", "block": {"path": 5, "send": "LVL {value}"}, "declared": ["http", "raw"], "form": "http"},
    {"name": "a setting's write has no udp form", "origin": "setting_write", "block": {"udp": {"port": 9, "payload": "x"}, "send": "LVL {value}"}, "declared": ["raw"], "form": "raw"},
    {"name": "a setting's empty line", "origin": "setting_write", "block": {"send": ""}, "declared": [], "form": null},
    {"name": "a setting's empty write", "origin": "setting_write", "block": {}, "declared": [], "form": null}
  ]
}
