{
  "about": "Which form a command, or a device setting's write, is sent in. Each case is a block's fields, the forms it declares (every form a field of it fills, in the order the runtime tries them) and the form it is sent in (the first of them; null when it declares none). A field that is null, false, zero, or an empty string, list or mapping reads as absent. Every reader that decides a form runs these: drivers/command_form.py, the checker, the runtime's senders, the Builder's dry run, the Live Test's summary, the simulator, and the Driver Builder's commandForm (validateDriver.ts).",
  "cases": [
    {"name": "a line", "origin": "command", "block": {"send": "PWR1\r"}, "declared": ["raw"], "form": "raw"},
    {"name": "an HTTP path", "origin": "command", "block": {"path": "/x"}, "declared": ["http"], "form": "http"},
    {"name": "an HTTP method alone", "origin": "command", "block": {"method": "POST"}, "declared": ["http"], "form": "http"},
    {"name": "an OSC address", "origin": "command", "block": {"address": "/x"}, "declared": ["osc"], "form": "osc"},
    {"name": "a udp block", "origin": "command", "block": {"udp": {"port": 9, "payload": "HI"}}, "declared": ["udp"], "form": "udp"},
    {"name": "an IR code", "origin": "command", "block": {"ir": {"pronto": "0000"}}, "declared": ["ir"], "form": "ir"},
    {"name": "an empty path beside a line", "origin": "command", "block": {"send": "PWR1\r", "path": ""}, "declared": ["raw"], "form": "raw"},
    {"name": "a null path beside a line", "origin": "command", "block": {"send": "PWR1\r", "path": null}, "declared": ["raw"], "form": "raw"},
    {"name": "an empty method beside a line", "origin": "command", "block": {"send": "PWR1\r", "method": ""}, "declared": ["raw"], "form": "raw"},
    {"name": "an empty address beside a line", "origin": "command", "block": {"send": "PWR1\r", "address": ""}, "declared": ["raw"], "form": "raw"},
    {"name": "a null address beside a line", "origin": "command", "block": {"send": "PWR1\r", "address": null}, "declared": ["raw"], "form": "raw"},
    {"name": "an empty udp block beside a line", "origin": "command", "block": {"send": "PWR1\r", "udp": {}}, "declared": ["raw"], "form": "raw"},
    {"name": "an empty IR code beside a line", "origin": "command", "block": {"send": "PWR1\r", "ir": {}}, "declared": ["raw"], "form": "raw"},
    {"name": "an empty list for a path beside a line", "origin": "command", "block": {"send": "PWR1\r", "path": []}, "declared": ["raw"], "form": "raw"},
    {"name": "an empty line beside a path", "origin": "command", "block": {"send": "", "path": "/x"}, "declared": ["http"], "form": "http"},
    {"name": "an empty line beside an address", "origin": "command", "block": {"send": "", "address": "/x"}, "declared": ["osc"], "form": "osc"},
    {"name": "the Builder's new TCP command", "origin": "command", "block": {"label": "New Command", "send": "", "params": {}}, "declared": [], "form": null},
    {"name": "the Builder's new HTTP command", "origin": "command", "block": {"label": "New Command", "send": "", "method": "GET", "path": "/", "params": {}}, "declared": ["http"], "form": "http"},
    {"name": "the Builder's new OSC command", "origin": "command", "block": {"label": "New Command", "send": "", "address": "/", "args": [], "params": {}}, "declared": ["osc"], "form": "osc"},
    {"name": "nothing", "origin": "command", "block": {}, "declared": [], "form": null},
    {"name": "an empty udp block alone", "origin": "command", "block": {"udp": {}}, "declared": [], "form": null},
    {"name": "a line that is a line feed (whitespace is sent)", "origin": "command", "block": {"send": "\n"}, "declared": ["raw"], "form": "raw"},
    {"name": "a path that is a space (not trimmed)", "origin": "command", "block": {"send": "PWR1\r", "path": " "}, "declared": ["http", "raw"], "form": "http"},
    {"name": "a filled path beside a line", "origin": "command", "block": {"send": "PWR1\r", "path": "/x"}, "declared": ["http", "raw"], "form": "http"},
    {"name": "a udp block beside a path", "origin": "command", "block": {"path": "/x", "udp": {"port": 9, "payload": "HELLO"}}, "declared": ["udp", "http"], "form": "udp"},
    {"name": "an IR code beside a udp block", "origin": "command", "block": {"ir": {"pronto": "0000"}, "udp": {"port": 9, "payload": "x"}}, "declared": ["ir", "udp"], "form": "ir"},
    {"name": "an address beside a path", "origin": "command", "block": {"address": "/x", "path": "/y"}, "declared": ["osc", "http"], "form": "osc"},
