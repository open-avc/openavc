{
  "_about": "What each row of a matrix is called: the name typed for it, else the name its device reports under label_key, else In N / Out N by where it was written. Run by tests/test_matrix_naming_parity.py: ui/matrix_model.py and the Builder's matrixModel.ts resolve each axis to the same entries, and the panel's modules/matrix.js names them as 'expected' says, given 'readings' as the device's state.",
  "cases": [
    {"name": "a typed name", "axis": "destinations",
     "spec": [{"value": 1, "label": "Apple TV"}], "readings": {}, "expected": ["Apple TV"]},
    {"name": "no name is its position", "axis": "destinations",
     "spec": [{"value": 5}, {"value": 6}], "readings": {}, "expected": ["Out 1", "Out 2"]},
    {"name": "a source with no name is its position", "axis": "sources",
     "spec": [{"value": 5}, {"value": 6}], "readings": {}, "expected": ["In 1", "In 2"]},
    {"name": "a bare value is its position", "axis": "destinations",
     "spec": [5, "HDMI_A"], "readings": {}, "expected": ["Out 1", "Out 2"]},
    {"name": "a name of zero is a name", "axis": "destinations",
     "spec": [{"value": 1, "label": 0}], "readings": {}, "expected": ["0"]},
    {"name": "an empty name is no name", "axis": "destinations",
     "spec": [{"value": 1, "label": ""}], "readings": {}, "expected": ["Out 1"]},
    {"name": "a null name is no name", "axis": "destinations",
     "spec": [{"value": 1, "label": null}], "readings": {}, "expected": ["Out 1"]},
    {"name": "the device's name", "axis": "destinations",
     "spec": [{"value": 1, "label_key": "device.mx.output.1.name"}],
     "readings": {"device.mx.output.1.name": "Lobby TV"}, "expected": ["Lobby TV"]},
    {"name": "the device's name not reported yet is its position", "axis": "destinations",
     "spec": [{"value": 1, "label_key": "device.mx.output.1.name"}], "readings": {}, "expected": ["Out 1"]},
    {"name": "the device's name reported empty is its position", "axis": "destinations",
     "spec": [{"value": 1, "label_key": "device.mx.output.1.name"}],
     "readings": {"device.mx.output.1.name": ""}, "expected": ["Out 1"]},
    {"name": "the device's name of zero is a name", "axis": "destinations",
     "spec": [{"value": 1, "label_key": "device.mx.output.1.name"}],
     "readings": {"device.mx.output.1.name": 0}, "expected": ["0"]},
    {"name": "a typed name beats the device's", "axis": "destinations",
     "spec": [{"value": 1, "label": "Main", "label_key": "device.mx.output.1.name"}],
     "readings": {"device.mx.output.1.name": "Rack name"}, "expected": ["Main"]},
    {"name": "an entry the list cannot read keeps the next one's place", "axis": "destinations",
     "spec": [{"value": 1}, {"label": "no value"}, {"value": 3, "label_key": "device.mx.output.3.name"}],
     "readings": {}, "expected": ["Out 1", "Out 3"]},
    {"name": "a generator names each by its place", "axis": "destinations",
     "spec": {"from": {"count": 3}}, "readings": {}, "expected": ["Out 1", "Out 2", "Out 3"]},
    {"name": "a generator's names, zero among them", "axis": "destinations",
     "spec": {"from": {"count": 3, "labels": ["Main", 0, ""]}}, "readings": {},
     "expected": ["Main", "0", "Out 3"]},
    {"name": "a generator's left-out port keeps the others' places", "axis": "destinations",
     "spec": {"from": {"count": 4, "label_key": "device.mx.output.*.name"}, "exclude": [2]},
     "readings": {"device.mx.output.4.name": "Booth"}, "expected": ["Out 1", "Out 3", "Booth"]},
    {"name": "a generator's override names one", "axis": "sources",
     "spec": {"from": {"count": 2}, "overrides": {"2": {"label": "Laptop"}}}, "readings": {},
     "expected": ["In 1", "Laptop"]}
  ]
}
