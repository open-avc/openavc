{
  "_comment": [
    "THE shared corpus for the monitor rule. Read by tests/test_monitor_parity.py",
    "(over openavc/core/monitors.py) and by",
    "openavc/web/programmer/src/api/monitorHelpers.test.ts (over monitorHelpers.ts).",
    "Both push every case through their side and compare against the same",
    "expectation, so a check or a wording that changes on one side lands on the",
    "other in the same commit or the suite goes red. Same arrangement as",
    "test_ui_review_parity.py, and for the same reason: the tile a person is",
    "looking at and the alert arriving on their phone must not disagree.",
    "",
    "It lives in tests/fixtures/ rather than tests/data/ because .gitignore has a",
    "bare `data/` rule, so a corpus under tests/data/ is silently untracked: it",
    "passes locally, where the file is on disk, and both suites fail in CI with",
    "ENOENT. That happened once; do not move it back.",
    "",
    "`status` is one of unset | no_value | normal | abnormal.",
    "`word` is the word a tile shows, or null when the value speaks for itself."
  ],
  "cases": [
    {
      "name": "no limits declared is never green",
      "monitor": { "key": "device.proj.lamp_hours", "label": "Lamp Hours", "unit": "hours", "type": "number" },
      "value": 412,
      "status": "unset",
      "word": null,
      "reading": "412 hours"
    },
    {
      "name": "no limits and no reading",
      "monitor": { "key": "device.proj.lamp_hours", "type": "number" },
      "value": null,
      "status": "unset",
      "word": null,
      "reading": "—"
    },
    {
      "name": "a key that has never reported draws no value, not zero",
      "monitor": { "key": "device.proj.lamp_hours", "type": "number", "normal_max": 2000 },
      "value": null,
      "status": "no_value",
      "word": null,
      "reading": "—"
    },
    {
      "name": "inside a two-sided range",
      "monitor": { "key": "device.dsp.temp_c", "unit": "°C", "type": "number", "normal_min": 10, "normal_max": 45 },
      "value": 31.5,
      "status": "normal",
      "word": null,
      "reading": "31.5 °C"
    },
    {
      "name": "below the minimum",
      "monitor": { "key": "device.dsp.temp_c", "type": "number", "normal_min": 10, "normal_max": 45 },
      "value": 4,
      "status": "abnormal",
      "word": null,
      "reading": "4"
    },
    {
      "name": "above the maximum",
      "monitor": { "key": "device.dsp.temp_c", "type": "number", "normal_min": 10, "normal_max": 45 },
      "value": 61,
      "status": "abnormal",
      "word": null,
      "reading": "61"
    },
    {
      "name": "exactly on the boundary is inside it",
      "monitor": { "key": "device.dsp.temp_c", "type": "number", "normal_min": 10, "normal_max": 45 },
      "value": 45,
      "status": "normal",
      "word": null,
      "reading": "45"
    },
    {
      "name": "a one-sided ceiling",
      "monitor": { "key": "device.proj.lamp_hours", "unit": "hours", "type": "number", "normal_max": 2000 },
      "value": 2400,
      "status": "abnormal",
      "word": null,
      "reading": "2400 hours"
    },
    {
      "name": "a number arriving as a string still compares",
      "monitor": { "key": "device.amp.temp", "type": "number", "normal_max": 50 },
      "value": "72.5",
      "status": "abnormal",
      "word": null,
      "reading": "72.5"
    },
    {
      "name": "a range cannot judge a word, so it claims nothing",
      "monitor": { "key": "device.amp.temp", "type": "number", "normal_max": 50 },
      "value": "warming up",
      "status": "unset",
      "word": null,
      "reading": "warming up"
    },
    {
      "name": "a range cannot judge a boolean either (float(True) is 1.0)",
      "monitor": { "key": "device.amp.temp", "type": "number", "normal_min": 5 },
      "value": true,
      "status": "unset",
      "word": "Yes",
      "reading": "Yes"
    },
    {
      "name": "a boolean reads as a word, never true/false",
      "monitor": { "key": "var.occupied", "type": "boolean" },
      "value": true,
      "status": "unset",
      "word": "Yes",
      "reading": "Yes"
    },
    {
      "name": "the author's words win over Yes/No",
      "monitor": {
        "key": "var.occupied",
        "type": "boolean",
        "states": { "true": { "label": "Occupied", "normal": true }, "false": { "label": "Vacant" } }
      },
      "value": true,
      "status": "normal",
      "word": "Occupied",
      "reading": "Occupied"
    },
    {
      "name": "the value the author did not call normal is abnormal",
      "monitor": {
        "key": "var.occupied",
        "type": "boolean",
        "states": { "true": { "label": "Occupied", "normal": true }, "false": { "label": "Vacant" } }
      },
      "value": false,
      "status": "abnormal",
      "word": "Vacant",
      "reading": "Vacant"
    },
    {
      "name": "a live boolean matches a states map keyed by JSON strings",
      "monitor": {
        "key": "device.amp.fault",
        "type": "boolean",
        "states": { "false": { "label": "OK", "normal": true }, "true": { "label": "Faulted" } }
      },
      "value": true,
      "status": "abnormal",
      "word": "Faulted",
      "reading": "Faulted"
    },
    {
      "name": "naming values is vocabulary, not a limit",
      "monitor": {
        "key": "device.sw.input",
        "type": "enum",
        "states": { "hdmi1": { "label": "Laptop" }, "hdmi2": { "label": "Room PC" } }
      },
      "value": "hdmi2",
      "status": "unset",
      "word": "Room PC",
      "reading": "Room PC"
    },
    {
      "name": "an enum inside its normal set",
      "monitor": {
        "key": "device.sw.input",
        "type": "enum",
        "states": {
          "hdmi1": { "label": "Laptop", "normal": true },
          "hdmi2": { "label": "Room PC", "normal": true },
          "none": { "label": "No Signal" }
        }
      },
      "value": "hdmi1",
      "status": "normal",
      "word": "Laptop",
      "reading": "Laptop"
    },
    {
      "name": "an enum outside it",
      "monitor": {
        "key": "device.sw.input",
        "type": "enum",
        "states": {
          "hdmi1": { "label": "Laptop", "normal": true },
          "hdmi2": { "label": "Room PC", "normal": true },
          "none": { "label": "No Signal" }
        }
      },
      "value": "none",
      "status": "abnormal",
      "word": "No Signal",
      "reading": "No Signal"
    },
    {
      "name": "a value nobody named is still judged, and shows itself",
      "monitor": {
        "key": "device.sw.input",
        "type": "enum",
        "states": { "hdmi1": { "label": "Laptop", "normal": true } }
      },
      "value": "hdmi3",
      "status": "abnormal",
      "word": null,
      "reading": "hdmi3"
    },
    {
      "name": "enum comparison stays case-sensitive (Mic and mic are different inputs)",
      "monitor": {
        "key": "device.mx.out.1.input",
        "type": "enum",
        "states": { "Mic": { "normal": true } }
      },
      "value": "mic",
      "status": "abnormal",
      "word": null,
      "reading": "mic"
    },
    {
      "name": "a states map with limits and no reading",
      "monitor": {
        "key": "device.amp.fault",
        "type": "boolean",
        "states": { "false": { "label": "OK", "normal": true } }
      },
      "value": null,
      "status": "no_value",
      "word": null,
      "reading": "—"
    },
    {
      "name": "values win over a range when both are declared",
      "monitor": {
        "key": "device.proj.power",
        "type": "enum",
        "normal_min": 0,
        "normal_max": 1,
        "states": { "on": { "label": "On", "normal": true } }
      },
      "value": "standby",
      "status": "abnormal",
      "word": null,
      "reading": "standby"
    },
    {
      "name": "a unit rides beside the number, not inside it",
      "monitor": { "key": "device.dsp.gain", "unit": "dB", "type": "number", "normal_min": -20, "normal_max": 0 },
      "value": -6,
      "status": "normal",
      "word": null,
      "reading": "-6 dB"
    },
    {
      "name": "zero is a reading, not an absence",
      "monitor": { "key": "device.proj.lamp_hours", "unit": "hours", "type": "number", "normal_max": 2000 },
      "value": 0,
      "status": "normal",
      "word": null,
      "reading": "0 hours"
    },
    {
      "name": "an empty string is not a number",
      "monitor": { "key": "device.amp.temp", "type": "number", "normal_max": 50 },
      "value": "",
      "status": "unset",
      "word": null,
      "reading": ""
    },
    {
      "name": "a bound that is not a number is not a limit",
      "monitor": { "key": "device.amp.temp", "unit": "C", "type": "number", "normal_max": "warm" },
      "value": 47,
      "status": "unset",
      "word": null,
      "reading": "47 C"
    },
    {
      "name": "a non-numeric bound on a key that has never reported is still unset, not no_value",
      "monitor": { "key": "device.amp.temp", "type": "number", "normal_min": "cold" },
      "value": null,
      "status": "unset",
      "word": null,
      "reading": "—"
    },
    {
      "name": "one good bound beside one that is not a number still judges on the good one",
      "monitor": { "key": "device.amp.temp", "unit": "C", "type": "number", "normal_min": 10, "normal_max": "warm" },
      "value": 4,
      "status": "abnormal",
      "word": null,
      "reading": "4 C"
    },
    {
      "name": "a bound written as a numeric string is a limit",
      "monitor": { "key": "device.amp.temp", "unit": "C", "type": "number", "normal_max": "40" },
      "value": 47,
      "status": "abnormal",
      "word": null,
      "reading": "47 C"
    },
    {
      "name": "a boolean is not a bound either",
      "monitor": { "key": "device.amp.temp", "unit": "C", "type": "number", "normal_min": false },
      "value": -3,
      "status": "unset",
      "word": null,
      "reading": "-3 C"
    },
    {
      "name": "declared words still hold when a bound beside them is a word too",
      "monitor": {
        "key": "device.amp.fault",
        "type": "enum",
        "normal_max": "warm",
        "states": { "ok": { "label": "Healthy", "normal": true } }
      },
      "value": "faulted",
      "status": "abnormal",
      "word": null,
      "reading": "faulted"
    },

    {
      "name": "decimals unset prints the float exactly as it arrived",
      "monitor": { "key": "device.lea.ac_line_current", "unit": "A", "type": "number" },
      "value": 0.08000000566244125,
      "status": "unset",
      "word": null,
      "reading": "0.08000000566244125 A"
    },
    {
      "name": "decimals rounds the float32-widened reading that caused this",
      "monitor": { "key": "device.lea.ac_line_current", "unit": "A", "type": "number", "display_decimals": 2 },
      "value": 0.08000000566244125,
      "status": "unset",
      "word": null,
      "reading": "0.08 A"
    },
    {
      "name": "decimals with no unit",
      "monitor": { "key": "var.temp", "type": "number", "display_decimals": 1 },
      "value": 121.30000305175781,
      "status": "unset",
      "word": null,
      "reading": "121.3"
    },
    {
      "name": "decimals zero is a real setting, not unset",
      "monitor": { "key": "var.temp", "unit": "C", "type": "number", "display_decimals": 0 },
      "value": 21.6,
      "status": "unset",
      "word": null,
      "reading": "22 C"
    },
    {
      "name": "a numeric STRING rounds too -- the cloud stores every value as text",
      "monitor": { "key": "device.lea.ac_line_current", "unit": "A", "type": "number", "display_decimals": 2 },
      "value": "0.08000000566244125",
      "status": "unset",
      "word": null,
      "reading": "0.08 A"
    },
    {
      "name": "decimals pads a short value out to the declared places",
      "monitor": { "key": "var.temp", "unit": "V", "type": "number", "display_decimals": 3 },
      "value": 121.3,
      "status": "unset",
      "word": null,
      "reading": "121.300 V"
    },

    {
      "name": "tie rounds away from zero, not to even (positive, 0 places)",
      "monitor": { "key": "var.n", "type": "number", "display_decimals": 0 },
      "value": 2.5,
      "status": "unset",
      "word": null,
      "reading": "3"
    },
    {
      "name": "tie rounds away from zero, not to even (negative fader, 0 places)",
      "monitor": { "key": "device.amp.channel.01.fader", "unit": "dB", "type": "number", "display_decimals": 0 },
      "value": -6.5,
      "status": "unset",
      "word": null,
      "reading": "-7 dB"
    },
    {
      "name": "tie at one place (a 0.25 dB step is a real fader step)",
      "monitor": { "key": "device.amp.channel.01.fader", "unit": "dB", "type": "number", "display_decimals": 1 },
      "value": 0.25,
      "status": "unset",
      "word": null,
      "reading": "0.3 dB"
    },
    {
      "name": "not a tie in binary, however it looks in decimal",
      "monitor": { "key": "var.n", "type": "number", "display_decimals": 2 },
      "value": 2.675,
      "status": "unset",
      "word": null,
      "reading": "2.67"
    },

    {
      "name": "decimals never touch the author's word for a value",
      "monitor": {
        "key": "device.proj.power",
        "type": "enum",
        "display_decimals": 2,
        "states": { "1": { "label": "Warming", "normal": true } }
      },
      "value": 1,
      "status": "normal",
      "word": "Warming",
      "reading": "Warming"
    },
    {
      "name": "decimals never touch a boolean",
      "monitor": { "key": "device.proj.faulted", "type": "boolean", "display_decimals": 2 },
      "value": true,
      "status": "unset",
      "word": "Yes",
      "reading": "Yes"
    },
    {
      "name": "decimals never touch text the device reports",
      "monitor": { "key": "device.proj.model", "type": "string", "display_decimals": 2 },
      "value": "NP-PA653U",
      "status": "unset",
      "word": null,
      "reading": "NP-PA653U"
    },
    {
      "name": "decimals say nothing about health -- the judgement reads the raw value",
      "monitor": {
        "key": "device.lea.ac_line_current",
        "unit": "A",
        "type": "number",
        "display_decimals": 0,
        "normal_min": 0.5,
        "normal_max": 10
      },
      "value": 10.4,
      "status": "abnormal",
      "word": null,
      "reading": "10 A"
    },

    {
      "name": "a stray decimals value is clamped, never handed to toFixed raw",
      "monitor": { "key": "var.n", "type": "number", "display_decimals": 999 },
      "value": 1.5,
      "status": "unset",
      "word": null,
      "reading": "1.50000000000000000000"
    },
    {
      "name": "a negative decimals value clamps to zero",
      "monitor": { "key": "var.n", "type": "number", "display_decimals": -3 },
      "value": 1.5,
      "status": "unset",
      "word": null,
      "reading": "2"
    },
    {
      "name": "a non-numeric decimals value is no declaration at all",
      "monitor": { "key": "var.n", "type": "number", "display_decimals": "two" },
      "value": 1.5,
      "status": "unset",
      "word": null,
      "reading": "1.5"
    },
    {
      "name": "past toFixed's exponential threshold both sides print the NUMBER, not the text",
      "monitor": { "key": "var.n", "type": "number", "display_decimals": 2 },
      "value": "1e21",
      "status": "unset",
      "word": null,
      "reading": "1e+21"
    },
    {
      "name": "decimals on a key that has never reported is still a dash",
      "monitor": { "key": "var.n", "unit": "A", "type": "number", "display_decimals": 2 },
      "value": null,
      "status": "unset",
      "word": null,
      "reading": "\u2014"
    }
  ]
}
