        "text": ".brand { background: #8AB493; color: white }\n.quoted { font-family: \"A;B\", serif; background-image: url(\"data:image/png;base64,AA;BB\") }\n.paren { background-image: url(data:image/png;base64,CC;DD); color: rgb(1, 2, 3) }\n.already { color: red !important; border-color: blue ! important; opacity: 0.5 }\n.vars { --brand: #8AB493; background: var(--brand); border: 1px solid var(--brand) }\n.escaped { font-family: \"a\\\";b\", sans-serif; width: 10px }\n.empty { }\n@media (min-width: 1px) { .wide { color: blue; margin: 0 } @media (max-width: 9999px) { .deep { padding: 1px } } }\n@supports (display: grid) { .grid { display: grid } }\n@keyframes pulse { from { opacity: 0 } to { opacity: 1 } }\n.after-frames { color: green }",
        "rules": [
          ".brand {background: #8AB493 !important; color: white !important;}",
          ".quoted {font-family: \"A;B\", serif !important; background-image: url(\"data:image/png;base64,AA;BB\") !important;}",
          ".paren {background-image: url(data:image/png;base64,CC;DD) !important; color: rgb(1, 2, 3) !important;}",
          ".already {color: red !important; border-color: blue ! important; opacity: 0.5 !important;}",
          ".vars {--brand: #8AB493 !important; background: var(--brand) !important; border: 1px solid var(--brand) !important;}",
          ".escaped {font-family: \"a\\\";b\", sans-serif !important; width: 10px !important;}",
          ".empty {}",
          "@4 (min-width: 1px)",
          " .wide {color: blue !important; margin: 0 !important;}",
          " @4 (max-width: 9999px)",
          "  .deep {padding: 1px !important;}",
          "@12 (display: grid)",
          " .grid {display: grid !important;}",
          "@7 pulse",
          " from {opacity: 0;} ",
          " to {opacity: 1;} ",
          ".after-frames {color: green !important;}"
        ],
        "cls": {}
      },
